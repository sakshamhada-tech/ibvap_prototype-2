# Copy to .env only if your process manager loads it; the application does
# not parse .env files automatically. Never commit real credentials.
IBVAP_VIDEO_SOURCE=0
IBVAP_DASHBOARD_USERNAME=operator
# These intentionally invalid placeholders make a copied file fail closed.
IBVAP_DASHBOARD_PASSWORD=CHANGEME
IBVAP_SESSION_SECRET=CHANGEME

# Set both in a direct-TLS deployment, or terminate TLS at a trusted proxy.
# IBVAP_TLS_CERTFILE=/run/secrets/tls.crt
# IBVAP_TLS_KEYFILE=/run/secrets/tls.key
# IBVAP_REQUIRE_HTTPS=true
# IBVAP_HTTPS_BEHIND_PROXY=true
# IBVAP_COOKIE_SECURE=true
# IBVAP_FORWARDED_ALLOW_IPS=127.0.0.1
# IBVAP_ALLOWED_HOSTS=surveillance.example.gov.in
# IBVAP_ALLOWED_ORIGINS=https://surveillance.example.gov.in

# Requires requirements-face.lock plus separately reviewed model files.
IBVAP_ENABLE_FACE_ENHANCEMENT=false
IBVAP_FACE_ENHANCEMENT_INTERVAL_FRAMES=15
IBVAP_FACE_ENHANCEMENT_MAX_FACES=4
IBVAP_FACE_ENHANCEMENT_DEVICE=auto
# GFPGAN runs only above these source-quality gates and contributes at most 50%.
IBVAP_SCRFD_MIN_FACE_SIZE_PX=32
IBVAP_GFPGAN_MIN_SOURCE_FACE_SIZE_PX=80
IBVAP_GFPGAN_MIN_SOURCE_SHARPNESS=30
IBVAP_GFPGAN_BLEND_WEIGHT=0.25
IBVAP_ENABLE_ANPR=false
IBVAP_VIRTUAL_FENCE=50,400,1200,400
IBVAP_VIRTUAL_FENCE_CONTACT_MARGIN_PX=2
IBVAP_SHOW_LIVE_WINDOW=false
IBVAP_SAVE_ANNOTATED_VIDEO=true
IBVAP_ANNOTATED_VIDEO_PATH=output/annotated_output.mp4
# Alerts default to logs/. Change this to output/alerts.csv if preferred.
IBVAP_ALERT_LOG_CSV=logs/alerts.csv
