# Copy to .env only if your process manager loads it; the application does
# not parse .env files automatically. Never commit real credentials.
IBVAP_VIDEO_SOURCE=0
IBVAP_DASHBOARD_USERNAME=operator
# These intentionally invalid placeholders make a copied file fail closed.
IBVAP_DASHBOARD_PASSWORD=CHANGEME
IBVAP_SESSION_SECRET=CHANGEME

# Set both in a direct-TLS deployment, or terminate TLS at a trusted proxy.
# IBVAP_TLS_CERTFILE=/run/secrets/tls.crt
# IBVAP_TLS_KEYFILE=/run/secrets/tls.key
# IBVAP_REQUIRE_HTTPS=true
# IBVAP_HTTPS_BEHIND_PROXY=true
# IBVAP_COOKIE_SECURE=true
# IBVAP_FORWARDED_ALLOW_IPS=127.0.0.1
# IBVAP_ALLOWED_HOSTS=surveillance.example.gov.in
# IBVAP_ALLOWED_ORIGINS=https://surveillance.example.gov.in

# Requires requirements-face.lock plus separately reviewed model files.
IBVAP_ENABLE_FACE_ENHANCEMENT=false
# Source extraction is non-generative. Keep experimental GFPGAN off for identity fidelity.
IBVAP_ENABLE_GFPGAN_RESTORATION=false
IBVAP_FACE_ENHANCEMENT_INTERVAL_FRAMES=15
IBVAP_FACE_ENHANCEMENT_MAX_FACES=4
IBVAP_FACE_ENHANCEMENT_DEVICE=auto
# If explicitly enabled, GFPGAN runs only above these conservative quality gates.
IBVAP_SCRFD_MIN_FACE_SIZE_PX=32
IBVAP_GFPGAN_MIN_SOURCE_FACE_SIZE_PX=96
IBVAP_GFPGAN_MIN_SOURCE_SHARPNESS=50
IBVAP_GFPGAN_BLEND_WEIGHT=0.10

# Regional ANPR is opt-in and requires requirements-anpr.lock plus explicitly
# acquired, SHA-256-verified detector weights. See README and model metadata.
IBVAP_ENABLE_ANPR=false
IBVAP_ANPR_PLATE_MODEL_PATH=models/indian_plate_yolov8n.pt
IBVAP_ANPR_PLATE_MODEL_SHA256=897ad71e4c94cb69aabdb6ba8fbd4bbecfad239fde6bc386ae04c650411787b4
IBVAP_ANPR_PLATE_DETECTION_CONFIDENCE=0.25
IBVAP_ANPR_PLATE_INPUT_SIZE=640
IBVAP_ANPR_MAX_PLATE_CANDIDATES=3
IBVAP_ANPR_INTERVAL_FRAMES=10
IBVAP_ANPR_MIN_PLATE_WIDTH_PX=80
IBVAP_ANPR_MIN_PLATE_SHARPNESS=20
IBVAP_ANPR_OCR_TARGET_HEIGHT_PX=64
IBVAP_ANPR_OCR_LANGUAGES=en
IBVAP_ANPR_REGIONS=IN
IBVAP_ANPR_MIN_OCR_CONFIDENCE=0.50
IBVAP_ANPR_MIN_CONSENSUS_READS=3
IBVAP_ANPR_CONSENSUS_WINDOW_SECONDS=3
IBVAP_ANPR_MIN_CONSENSUS_WEIGHT_RATIO=0.60
IBVAP_ANPR_MAX_OBSERVATIONS_PER_TRACK=12
IBVAP_ANPR_STATE_TTL_SECONDS=5

IBVAP_VIRTUAL_FENCE=50,400,1200,400
IBVAP_VIRTUAL_FENCE_CONTACT_MARGIN_PX=2
# Server-side tones: urgent alternating fence alarm and slower loitering warning.
IBVAP_ENABLE_AUDIBLE_ALARMS=true
IBVAP_AUDIBLE_ALARM_EVENTS=VIRTUAL_FENCE_INTRUSION,SUSPICIOUS_LOITERING
IBVAP_AUDIBLE_ALARM_VOLUME=0.75
IBVAP_AUDIBLE_ALARM_COOLDOWN_SECONDS=5
IBVAP_SHOW_LIVE_WINDOW=false
IBVAP_SAVE_ANNOTATED_VIDEO=true
IBVAP_ANNOTATED_VIDEO_PATH=output/annotated_output.mp4
# Analytics alerts and dashboard security events are separate rotating logs.
# Change the CSV to output/alerts.csv if preferred.
IBVAP_ALERT_LOG_CSV=logs/alerts.csv
IBVAP_AUDIT_LOG_JSONL=logs/audit.jsonl
