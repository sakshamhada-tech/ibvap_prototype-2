# Copy to .env only if your process manager loads it; the application does
# not parse .env files automatically. Never commit real credentials.
IBVAP_VIDEO_SOURCE=0
IBVAP_DASHBOARD_USERNAME=operator
# These intentionally invalid placeholders make a copied file fail closed.
IBVAP_DASHBOARD_PASSWORD=CHANGEME
IBVAP_SESSION_SECRET=CHANGEME

# Set both in a direct-TLS deployment, or terminate TLS at a trusted proxy.
# IBVAP_TLS_CERTFILE=/run/secrets/tls.crt
# IBVAP_TLS_KEYFILE=/run/secrets/tls.key
# IBVAP_REQUIRE_HTTPS=true
# IBVAP_HTTPS_BEHIND_PROXY=true
# IBVAP_COOKIE_SECURE=true
# IBVAP_FORWARDED_ALLOW_IPS=127.0.0.1
# IBVAP_ALLOWED_HOSTS=surveillance.example.gov.in
# IBVAP_ALLOWED_ORIGINS=https://surveillance.example.gov.in

# Requires requirements-face.lock plus separately reviewed model files.
IBVAP_ENABLE_FACE_ENHANCEMENT=false
# Source extraction is non-generative. Keep experimental GFPGAN off for identity fidelity.
IBVAP_ENABLE_GFPGAN_RESTORATION=false
IBVAP_FACE_ENHANCEMENT_INTERVAL_FRAMES=15
IBVAP_FACE_ENHANCEMENT_MAX_FACES=4
IBVAP_FACE_ENHANCEMENT_DEVICE=auto
# If explicitly enabled, GFPGAN runs only above these conservative quality gates.
IBVAP_SCRFD_MIN_FACE_SIZE_PX=32
IBVAP_GFPGAN_MIN_SOURCE_FACE_SIZE_PX=96
IBVAP_GFPGAN_MIN_SOURCE_SHARPNESS=50
IBVAP_GFPGAN_BLEND_WEIGHT=0.10

# Regional ANPR is opt-in and requires requirements-anpr.lock plus explicitly
# acquired, SHA-256-verified detector weights. See README and model metadata.
IBVAP_ENABLE_ANPR=false
# Debug logging can contain recognized plate text; use only for controlled diagnosis.
IBVAP_ANPR_DEBUG=false
IBVAP_ANPR_PLATE_MODEL_PATH=models/indian_plate_yolov8n.pt
IBVAP_ANPR_PLATE_MODEL_SHA256=897ad71e4c94cb69aabdb6ba8fbd4bbecfad239fde6bc386ae04c650411787b4
IBVAP_ANPR_PLATE_DETECTION_CONFIDENCE=0.25
IBVAP_ANPR_PLATE_INPUT_SIZE=640
IBVAP_ANPR_MAX_PLATE_CANDIDATES=3
IBVAP_ANPR_INTERVAL_FRAMES=10
IBVAP_ANPR_MIN_PLATE_WIDTH_PX=80
IBVAP_ANPR_MIN_PLATE_SHARPNESS=20
IBVAP_ANPR_OCR_TARGET_HEIGHT_PX=64
IBVAP_ANPR_OCR_LANGUAGES=en
IBVAP_ANPR_REGIONS=IN
IBVAP_ANPR_MIN_OCR_CONFIDENCE=0.50
IBVAP_ANPR_MIN_CONSENSUS_READS=3
IBVAP_ANPR_CONSENSUS_WINDOW_SECONDS=3
IBVAP_ANPR_MIN_CONSENSUS_WEIGHT_RATIO=0.60
IBVAP_ANPR_MAX_OBSERVATIONS_PER_TRACK=12
IBVAP_ANPR_STATE_TTL_SECONDS=5

IBVAP_VIRTUAL_FENCE=50,400,1200,400
IBVAP_VIRTUAL_FENCE_CONTACT_MARGIN_PX=2
# Whole-frame loitering by default; polygon syntax is x,y;x,y;x,y.
IBVAP_LOITERING_ZONE=anywhere

# Classical-CV context signals; all are experimental and opt-in.
IBVAP_ENABLE_GROUP_APPROACH=false
IBVAP_GROUP_MIN_SIZE=3
IBVAP_GROUP_PROXIMITY_PX=160
IBVAP_GROUP_APPROACH_WINDOW_SECONDS=3
IBVAP_GROUP_MIN_SPEED_PX_PER_SECOND=5
IBVAP_GROUP_HEADING_SIMILARITY=0.75
IBVAP_GROUP_MIN_FENCE_PROGRESS_PX=12
IBVAP_ENABLE_MOTION_SIGNATURE=false
IBVAP_MOTION_SIGNATURE_WINDOW_SECONDS=3
IBVAP_MOTION_SIGNATURE_MIN_SAMPLES=8
IBVAP_MOTION_SIGNATURE_STATIC_PATH_PX=3
IBVAP_MOTION_SIGNATURE_VEGETATION_MAX_NET_PX=8
IBVAP_MOTION_SIGNATURE_HIGH_FREQUENCY_RATIO=0.5
IBVAP_MOTION_SIGNATURE_DISPLACEMENT_SCALE_PX=40
IBVAP_MOTION_SIGNATURE_OSCILLATION_SCALE_PX=4
IBVAP_MOTION_SIGNATURE_STATIC_SCORE=0
IBVAP_MOTION_SIGNATURE_VEGETATION_SCORE=0.05
IBVAP_MOTION_SIGNATURE_GAIT_SCORE=0.8
IBVAP_MOTION_SIGNATURE_RIGID_SCORE=0.4
IBVAP_MOTION_SIGNATURE_AMBIGUOUS_SCORE=0.2

# Composite scoring remains a human-review signal and defaults off.
IBVAP_ENABLE_CONTEXTUAL_RISK=false
IBVAP_RISK_ALERT_THRESHOLD=0.65
IBVAP_RISK_FENCE_PROXIMITY_PX=180
IBVAP_RISK_WEIGHT_FENCE_CONTACT=0.35
IBVAP_RISK_WEIGHT_FENCE_PROXIMITY=0.15
IBVAP_RISK_WEIGHT_LOITERING=0.20
IBVAP_RISK_WEIGHT_MOTION_SIGNATURE=0.10
IBVAP_RISK_WEIGHT_LOW_POSTURE=0.20
IBVAP_RISK_WEIGHT_NIGHT=0.10
IBVAP_RISK_WEIGHT_FENCE_APPROACH=0.20
IBVAP_RISK_WEIGHT_GROUP_MEMBERSHIP=0.20
IBVAP_RISK_WEIGHT_FIREARM=0.50

# Optional tiled detection improves small-object recall at an explicit FPS cost.
IBVAP_ENABLE_TILED_INFERENCE=false
IBVAP_TILE_SIZE=640
IBVAP_TILE_OVERLAP=0.20
IBVAP_TILED_INFERENCE_INTERVAL_FRAMES=30
IBVAP_TILED_INFERENCE_NMS_IOU=0.50

# Optional pose model: provide a reviewed local file and mandatory SHA-256.
IBVAP_ENABLE_POSTURE_ANALYSIS=false
IBVAP_POSTURE_MODEL_PATH=models/yolov8n-pose.pt
# IBVAP_POSTURE_MODEL_SHA256=<64-character-reviewed-sha256>
IBVAP_POSTURE_CONFIDENCE_THRESHOLD=0.60
IBVAP_POSTURE_INTERVAL_FRAMES=15
IBVAP_POSTURE_MAX_PEOPLE=4
IBVAP_POSTURE_MIN_PERSON_SIZE_PX=96
IBVAP_POSTURE_LOW_ASPECT_RATIO=0.9
IBVAP_POSTURE_MAX_VERTICAL_SPREAD_RATIO=0.55
IBVAP_POSTURE_MIN_VISIBLE_KEYPOINTS=3
IBVAP_POSTURE_MIN_KEYPOINT_CONFIDENCE=0.40
IBVAP_POSTURE_SUSTAIN_SECONDS=1.5
IBVAP_POSTURE_STATE_TTL_SECONDS=3
IBVAP_POSTURE_RESULT_MAX_AGE_FRAMES=45
IBVAP_POSTURE_DEVICE=auto

# Optional separate firearm model: conservative review flag, never auto-response.
IBVAP_ENABLE_FIREARM_DETECTION=false
IBVAP_FIREARM_MODEL_PATH=models/firearm_detector.pt
# IBVAP_FIREARM_MODEL_SHA256=<64-character-reviewed-sha256>
IBVAP_FIREARM_CONFIDENCE_THRESHOLD=0.80
IBVAP_FIREARM_INTERVAL_FRAMES=15
IBVAP_FIREARM_RESULT_MAX_AGE_FRAMES=45
IBVAP_FIREARM_DEVICE=auto

# Server-side tones: new review signals are supported but remain inaudible by default.
IBVAP_ENABLE_AUDIBLE_ALARMS=true
IBVAP_AUDIBLE_ALARM_EVENTS=VIRTUAL_FENCE_INTRUSION,SUSPICIOUS_LOITERING
IBVAP_AUDIBLE_ALARM_VOLUME=0.75
IBVAP_AUDIBLE_ALARM_COOLDOWN_SECONDS=5
IBVAP_SHOW_LIVE_WINDOW=false
IBVAP_SAVE_ANNOTATED_VIDEO=true
IBVAP_ANNOTATED_VIDEO_PATH=output/annotated_output.mp4
# Analytics alerts and dashboard security events are separate rotating logs.
# Change the CSV to output/alerts.csv if preferred.
IBVAP_ALERT_LOG_CSV=logs/alerts.csv
IBVAP_AUDIT_LOG_JSONL=logs/audit.jsonl
